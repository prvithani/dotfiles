#!/usr/bin/env bash
# Toggle a side pane in the current tmux window.
#   tmux-side board    [window] [dir] [pane]   the session's board, then the project's
#   tmux-side glossary [window] [dir] [pane]   the session's glossary, then the project's
#   tmux-side files    [window] [dir] [pane]   pick a scratch or plan file, then read it
#
# Where the files live:
#   project  ~/.claude/projects/<slug>/{board,glossary}.md (see board-tool)
#   session  <project>/sessions/<session-id>/{board,glossary}.md, the id read
#            from the Claude pane's @claude_session (set by tmux-state.sh)
# Below both: items and terms ended sessions left that the project lacks.
#
# The same binding closes the pane again. In a viewer, r re-renders (picking up
# Claude's edits) and q quits: board and glossary close, files returns to the
# list. Markdown renders through rich; other files highlight with pygments.
set -euo pipefail

mode=${1:?usage: tmux-side board|glossary|files [window-id] [dir] [pane-id]}
win=${2:-}
dir=${3:-$PWD}
caller=${4:-}
self=$(readlink -f "$0")
tool=$(dirname "$self")/board-tool

# Render one file for a terminal of the pane's width.
render() {
  local f=$1 w; w=$(tput cols 2>/dev/null || echo 100)
  case $f in
    *.md)       python3 -m rich.markdown -c -t one-dark -w "$w" "$f" ;;
    *.edn|*.clj|*.cljc|*.cljs) pygmentize -f terminal256 -O style=one-dark -l clojure "$f" ;;
    *)          pygmentize -f terminal256 -O style=one-dark "$f" 2>/dev/null || cat "$f" ;;
  esac
}

# r quits less with exit status 114 ('r'); the callers re-render on it.
keys=${TMPDIR:-/tmp}/tmux-side.lesskey
printf '#command\nr quit r\n' > "$keys"
reload=114
page() { local st=0; less -R --lesskey-src="$keys" || st=$?; return $st; }

# The session file (when the session has one), the project file, then what
# ended sessions left that the project file does not carry yet.
layered() {
  local name=$1
  local s="$SIDE_PROJECT/sessions/${SIDE_SESSION:-none}/$name.md" p="$SIDE_PROJECT/$name.md"
  local extra; extra=$(mktemp --suffix=.md)
  "$tool" "stranded-$name" "$SIDE_PROJECT" "${SIDE_SESSION:-none}" > "$extra" || true
  { [ -f "$s" ] && { render "$s"; echo; }
    [ -f "$p" ] && render "$p"
    [ -s "$extra" ] && { echo; render "$extra"; }
    [ -f "$s" ] || [ -f "$p" ] || echo "No $name yet for $SIDE_PROJECT"
  } | page
  local st=$?; rm -f "$extra"; return $st
}

if [ "$win" = "--run" ]; then
  case $mode in
    board|glossary)
      while st=0; layered "$mode" || st=$?; [ $st -eq $reload ]; do :; done
      exit 0 ;;
    files)
      root=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || echo "$PWD")
      list() {
        { for n in board glossary; do
            [ -f "$SIDE_PROJECT/sessions/${SIDE_SESSION:-none}/$n.md" ] && echo "$SIDE_PROJECT/sessions/$SIDE_SESSION/$n.md"
            [ -f "$SIDE_PROJECT/$n.md" ] && echo "$SIDE_PROJECT/$n.md"
          done
          find "$root" -maxdepth 4 -type f \( -path '*/.scratch/*' -o -path '*/.claude/plans/*' \) \
               \( -name '*.md' -o -name '*.org' -o -name '*.txt' -o -name '*.edn' \) \
               -not -path '*/node_modules/*' -printf '%T@ %p\n' 2>/dev/null | sort -rn | cut -d' ' -f2-
        } | sed "s|^$root/||; s|^$HOME/|~/|"
      }
      path() { case $1 in "~/"*) echo "$HOME/${1#\~/}" ;; /*) echo "$1" ;; *) echo "$root/$1" ;; esac; }
      export -f render path; export root
      while sel=$(list | fzf --prompt 'file> ' --height 100% --reverse --ansi \
                    --preview 'bash -c "render \"\$(path {})\" | head -120"' \
                    --preview-window down,60%); do
        while st=0; render "$(path "$sel")" | page || st=$?; [ $st -eq $reload ]; do :; done
      done
      exit 0 ;;
  esac
fi

# Toggle: close this mode's pane if the window has one, else open it.
tgt=${win:+-t $win}
pane=$(tmux list-panes $tgt -F '#{pane_id} #{@side}' | awk -v m="$mode" '$2 == m {print $1; exit}')
if [ -n "$pane" ]; then
  tmux kill-pane -t "$pane"
  exit 0
fi

# The Claude session this pane belongs to: the calling pane's, else the first
# Claude pane in the window. Its directory decides the project.
sid=""; cdir=$dir
if [ -n "$caller" ]; then sid=$(tmux show -pv -t "$caller" @claude_session 2>/dev/null || true); fi
if [ -z "$sid" ]; then
  read -r sid cdir < <(tmux list-panes $tgt -F '#{@claude_session} #{pane_current_path}' \
                        | awk '$1 != "" {print; exit}') || true
  cdir=${cdir:-$dir}
fi
proj=$("$tool" project "$cdir")

new=$(tmux split-window $tgt -c "$dir" -h -l 30% -P -F '#{pane_id}' \
        -e SIDE_PROJECT="$proj" -e SIDE_SESSION="$sid" "$self $mode --run")
tmux set -p -t "$new" @side "$mode"
tmux select-pane -t "$new" -T "$mode"
