#!/usr/bin/env bash
# Finds a project's board and glossary files and what earlier sessions left open.
#   board-tool project DIR                 the project directory for DIR
#   board-tool stranded-board PROJECT SID      open items on other sessions' boards
#   board-tool stranded-glossary PROJECT SID   other sessions' terms the project lacks
#   board-tool ended PROJECT SID               mark a session ended (session-end hook)
#   board-tool clear [--done] [SID]            empty a session board; --done drops
#                                              only ✅ and ❌ items
#   board-tool promote [SID]                   move a session board's open items
#                                              to the project board
#   board-tool prune                           move the project board's ✅ and ❌
#                                              items to board-archive.md
#
# Only ENDED sessions are scanned, so a session still running in another pane is
# never reported as abandoned. A session has ended when it wrote an `ended`
# marker (clean exit), or when no tmux pane carries its id (@claude_session,
# set by tmux-state.sh) and its board has not changed for STALE_MIN minutes
# (default 120; covers a crash, where no session-end hook runs).
#
# Project: ~/.claude/projects/<slug>, <slug> being the nearest ancestor of DIR
# with a board there (else DIR), every non-alphanumeric character as "-".
# Session files: <project>/sessions/<id>/{board,glossary}.md. An item is open
# unless it is ✅ or ❌; promoting it moves it to the project board, so what
# remains on a session board is what nobody has carried forward yet.
set -euo pipefail

projects=$HOME/.claude/projects
slug() { printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g'; }

project() {
  local d=$1
  while :; do
    [ -f "$projects/$(slug "$d")/board.md" ] && { readlink -f "$projects/$(slug "$d")"; return; }
    [ "$d" = / ] && break
    d=$(dirname "$d")
  done
  echo "$projects/$(slug "$1")"
}

stale_min=${STALE_MIN:-120}

# Session ids that a tmux pane still carries: running sessions.
live() { tmux list-panes -a -F '#{@claude_session}' 2>/dev/null | grep -v '^$' || true; }

# Ended sessions' files of one kind, newest first, excluding session `sid`.
others() {
  local proj=$1 sid=$2 name=$3 f d id running
  running=$(live)
  for f in $(ls -t "$proj"/sessions/*/"$name.md" 2>/dev/null); do
    d=$(dirname "$f"); id=$(basename "$d")
    [ "$id" = "$sid" ] && continue
    if [ ! -f "$d/ended" ]; then
      grep -qxF -- "$id" <<<"$running" && continue
      [ -n "$(find "$d" -maxdepth 1 -name board.md -mmin -"$stale_min" 2>/dev/null)" ] && continue
    fi
    echo "$f"
  done
}

stranded_board() {
  local proj=$1 sid=$2 out="" f items title
  for f in $(others "$proj" "$sid" board); do
    items=$(grep -E '^\s*- (🔲|🔄|👀|⏳|❓|💤) ' "$f" || true)
    [ -n "$items" ] || continue
    title=$(grep -m1 '^# ' "$f" | sed 's/^# //')
    out+="### ${title:-session} ($(basename "$(dirname "$f")" | cut -c1-8), $(date -r "$f" +%F))"$'\n'"$items"$'\n\n'
  done
  [ -n "$out" ] && printf '## Open in ended sessions\n\n%s' "$out"
  return 0
}

stranded_glossary() {
  local proj=$1 sid=$2 out="" f line term
  local known; known=$(grep -oE '^- \*\*[^*]+\*\*' "$proj/glossary.md" 2>/dev/null || true)
  for f in $(others "$proj" "$sid" glossary); do
    while IFS= read -r line; do
      term=$(grep -oE '^- \*\*[^*]+\*\*' <<<"$line")
      grep -qxF -- "$term" <<<"$known" || { out+="$line"$'\n'; known+=$'\n'"$term"; }
    done < <(grep -E '^- \*\*[^*]+\*\*' "$f" || true)
  done
  [ -n "$out" ] && printf '## Terms from ended sessions, not in the project glossary\n\n%s' "$out"
  return 0
}

# The board of session SID, or else of the Claude pane in this tmux window.
session_board() {
  local sid proj f
  sid=${1:-$(tmux list-panes -F '#{@claude_session}' 2>/dev/null | grep -m1 . || true)}
  [ -n "$sid" ] || { echo "board-tool: no SID given and no Claude pane in this window" >&2; exit 1; }
  proj=$(project "$PWD"); f=$proj/sessions/$sid/board.md
  [ -f "$f" ] || { echo "board-tool: no board at $f" >&2; exit 1; }
  echo "$f"
}

# Plain clear refuses while open items remain: promote them first.
clear_board() {
  local done=0 f open
  [ "${1:-}" = --done ] && { done=1; shift; }
  f=$(session_board "${1:-}")
  if [ $done = 1 ]; then
    sed -i -E '/^\s*- (✅|❌) /d' "$f"
  else
    open=$(grep -E '^\s*- (🔲|🔄|👀|⏳|❓|💤) ' "$f" || true)
    [ -z "$open" ] || { printf 'board-tool: open items on %s; promote them or use --done:\n%s\n' "$f" "$open" >&2; exit 1; }
    : > "$f"
  fi
  echo "cleared $f"
}

# Moves items, with their indented lines, from board SRC to file DST and drops
# the sections that leaves empty.
#   promote: open items go to the project board, under the section of the same
#            "## " heading, else under a section named after the session title.
#   prune:   ✅ and ❌ items go to the archive, under "## <date>", one "### "
#            subsection per board section.
mover='
import re, sys, datetime
mode, sf, df = sys.argv[1:4]
item = re.compile(r"^\s*- (🔲|🔄|👀|⏳|❓|💤) " if mode == "promote" else r"^\s*- (✅|❌) ")
any_item = re.compile(r"^\s*- \S+ ")
lines = open(sf).read().splitlines()
title = next((l[2:] for l in lines if l.startswith("# ")), "session")
title = title.removeprefix("Session board — ").removeprefix("Board — ")
keep, moved, section, taking = [], {}, None, False
for l in lines:
    if l.startswith("## "):
        section, taking = l, False
    elif item.match(l):
        taking = True
    elif not (taking and l.startswith((" ", "\t")) and l.strip() and not any_item.match(l)):
        taking = False
    (moved.setdefault(section, []) if taking else keep).append(l)
if not moved:
    print(f"nothing to move on {sf}"); sys.exit(0)
# Drop "## " sections the move emptied (heading plus blank lines only).
out, block = [], []
for l in keep + ["## "]:
    if l.startswith("## "):
        if not (block and block[0] in moved and not any(x.strip() for x in block[1:])):
            out += block
        block = []
    block.append(l)
keep = out
while keep and not keep[-1].strip():
    keep.pop()
try:
    dst = open(df).read().splitlines()
except FileNotFoundError:
    dst = ["# Board" if mode == "promote" else f"# Board archive — {title}"]
today = str(datetime.date.today())
if mode == "prune" and f"## {today}" not in dst:
    dst += ["", f"## {today}"]
for sec, items in moved.items():
    n = sum(bool(item.match(l)) for l in items)
    if mode == "prune":
        dst += ["", "### " + (sec[3:] if sec else "(no section)"), ""] + items
        print(f"{n} item(s) <- {sec or title}")
        continue
    head = sec or f"## {title} ({today})"
    if head in dst:
        i = dst.index(head) + 1
        while i < len(dst) and not dst[i].startswith("## "):
            i += 1
        while i > 0 and not dst[i - 1].strip():
            i -= 1
        dst[i:i] = items
    else:
        dst += ["", head, ""] + items
    print(f"{n} item(s) -> {head}")
open(df, "w").write("\n".join(dst) + "\n")
open(sf, "w").write("\n".join(keep) + "\n")
'

promote() {
  local f; f=$(session_board "${1:-}")
  python3 -c "$mover" promote "$f" "$(dirname "$(dirname "$(dirname "$f")")")/board.md"
}

prune() {
  local proj; proj=$(project "$PWD")
  [ -f "$proj/board.md" ] || { echo "board-tool: no board at $proj/board.md" >&2; exit 1; }
  python3 -c "$mover" prune "$proj/board.md" "$proj/board-archive.md"
}

case ${1:-} in
  project)           project "${2:?dir}" ;;
  stranded-board)    stranded_board "${2:?project}" "${3:-none}" ;;
  stranded-glossary) stranded_glossary "${2:?project}" "${3:-none}" ;;
  clear)             shift; clear_board "$@" ;;
  promote)           shift; promote "$@" ;;
  prune)             prune ;;
  ended)             [ -d "${2:?project}/sessions/${3:?sid}" ] && date -Is > "$2/sessions/$3/ended"; exit 0 ;;
  *) echo "usage: board-tool project DIR | stranded-board|stranded-glossary|ended PROJECT SID | clear [--done] [SID] | promote [SID] | prune" >&2; exit 2 ;;
esac
